# Template for the VPS deployment. Copy to `.env` on the server, fill it in,
# and lock it down with `chmod 600 .env`. Never commit the filled-in copy.

# --- Secrets -----------------------------------------------------------------
# Generate with: openssl rand -base64 24 | tr -d '/+=' | head -c 32
POSTGRES_PASSWORD=
OPENAI_API_KEY=

# --- Public address ----------------------------------------------------------
# A hostname makes Caddy request a Let's Encrypt certificate automatically.
# Use `:80` instead to serve plain HTTP while testing.
SITE_ADDRESS=srv1952923.hstgr.cloud

# --- Application -------------------------------------------------------------
# DATABASE_URL, QDRANT_URL, and REDIS_URL are set by docker-compose.prod.yml
# from the internal service names; do not set them here.
QDRANT_COLLECTION=enterprise_documents
CHAT_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
# A background worker handles ingestion here, so uploads are not bounded by an
# HTTP request timeout and the 20 MB default is safe.
MAX_UPLOAD_BYTES=20971520
TOP_K=20
RERANK_K=8
SCORE_THRESHOLD=0.25
QDRANT_TIMEOUT_SECONDS=60
INDEXING_BATCH_SIZE=32
LOG_LEVEL=INFO
