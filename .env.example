# Copy this file to .env and fill in secrets locally. Never commit real secrets.
OPENAI_API_KEY=
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=enterprise_documents
# `gpt-4o-mini` is economical for development. Test a higher-quality model on
# a representative evaluation set before changing this value for production.
CHAT_MODEL=gpt-4o-mini
MAX_UPLOAD_BYTES=10485760
TOP_K=8
RERANK_K=4
LOG_LEVEL=INFO
# Keep individual cloud writes short and retryable rather than sending a whole
# document in one request. Increase timeout only when your network requires it.
QDRANT_TIMEOUT_SECONDS=60
INDEXING_BATCH_SIZE=32

# SQLAlchemy URL. Leave unset to use the local SQLite file; set a
# postgresql+psycopg:// URL in any deployed environment.
DATABASE_URL=

# Celery broker. Leave empty to disable background ingestion entirely, which
# makes uploads parse and embed inside the HTTP request instead. Deployments
# without a worker process (Render's free tier has none) should set it empty.
REDIS_URL=redis://localhost:6379/0

# Comma-separated browser origins allowed to call the API. A frontend served
# from its own domain — such as a Render static site — must be listed here.
ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
