# Copy this file to .env and fill in secrets locally. Never commit real secrets.
OPENAI_API_KEY=
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=enterprise_documents
# `gpt-4o-mini` is economical for development. Test a higher-quality model on
# a representative evaluation set before changing this value for production.
CHAT_MODEL=gpt-4o-mini
MAX_UPLOAD_BYTES=10485760
TOP_K=8
RERANK_K=4
LOG_LEVEL=INFO
# Keep individual cloud writes short and retryable rather than sending a whole
# document in one request. Increase timeout only when your network requires it.
QDRANT_TIMEOUT_SECONDS=60
INDEXING_BATCH_SIZE=32
